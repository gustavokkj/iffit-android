<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:background="@color/iffit_background"
  android:fitsSystemWindows="true">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/app_name"
      android:textSize="14sp"
      android:textColor="@color/iffit_primary"
      android:layout_marginBottom="12dp"
      android:lineSpacingExtra="3dp" />
    <TextView
      android:id="@+id/textCadastroUsuarioTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/cadastro_usuario_comece_sua_jornada"
      android:textSize="32sp"
      android:textColor="@color/iffit_text"
      android:layout_marginBottom="12dp"
      android:lineSpacingExtra="3dp"
      android:fontFamily="sans-serif-medium" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/cadastro_usuario_crie_sua_conta_e_encontre_seu_ritmo"
      android:textSize="15sp"
      android:textColor="@color/iffit_muted"
      android:layout_marginBottom="12dp"
      android:lineSpacingExtra="3dp" />
    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="20dp"
      app:cardCornerRadius="24dp"
      app:cardElevation="0dp"
      app:strokeWidth="1dp"
      app:strokeColor="@color/iffit_border"
      app:cardBackgroundColor="@color/iffit_surface">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/cadastro_usuario_nome"
          android:layout_marginBottom="12dp"
          app:boxCornerRadiusTopStart="14dp"
          app:boxCornerRadiusTopEnd="14dp"
          app:boxCornerRadiusBottomStart="14dp"
          app:boxCornerRadiusBottomEnd="14dp">
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/registerNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textPersonName"
            android:textColor="@color/iffit_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/cadastro_usuario_e_mail"
          android:layout_marginBottom="12dp"
          app:boxCornerRadiusTopStart="14dp"
          app:boxCornerRadiusTopEnd="14dp"
          app:boxCornerRadiusBottomStart="14dp"
          app:boxCornerRadiusBottomEnd="14dp">
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/registerEmailEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textEmailAddress"
            android:textColor="@color/iffit_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/cadastro_usuario_senha"
          android:layout_marginBottom="12dp"
          app:boxCornerRadiusTopStart="14dp"
          app:boxCornerRadiusTopEnd="14dp"
          app:boxCornerRadiusBottomStart="14dp"
          app:boxCornerRadiusBottomEnd="14dp"
          app:endIconMode="password_toggle">
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/registerPasswordEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textPassword"
            android:textColor="@color/iffit_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
          style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:hint="@string/cadastro_usuario_confirme_a_senha"
          android:layout_marginBottom="12dp"
          app:boxCornerRadiusTopStart="14dp"
          app:boxCornerRadiusTopEnd="14dp"
          app:boxCornerRadiusBottomStart="14dp"
          app:boxCornerRadiusBottomEnd="14dp"
          app:endIconMode="password_toggle">
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/registerConfirmPasswordEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:inputType="textPassword"
            android:textColor="@color/iffit_text" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
          android:id="@+id/salvarButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="56dp"
          android:layout_marginTop="8dp"
          android:text="@string/cadastro_usuario_criar_conta"
          android:textAllCaps="false"
          android:textSize="16sp"
          app:cornerRadius="18dp" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/sairButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="56dp"
          android:layout_marginTop="8dp"
          android:text="@string/cadastro_usuario_voltar_para_o_login"
          android:textAllCaps="false"
          android:textSize="16sp"
          app:cornerRadius="18dp"
          style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
  </LinearLayout>
</ScrollView>