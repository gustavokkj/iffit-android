<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/iffit_surface"
  android:fillViewport="true">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="30dp"
    android:paddingEnd="28dp"
    android:paddingBottom="32dp">
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <View
        android:layout_width="7dp"
        android:layout_height="28dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/login_brand_mark" />
      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="@string/app_name"
        android:textColor="@color/iffit_primary"
        android:textSize="21sp" />
    </LinearLayout>
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="34dp"
      android:fontFamily="sans-serif-medium"
      android:text="@string/notifications_pequenas_vitorias"
      android:textColor="@color/iffit_text"
      android:textSize="34sp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="32dp"
      android:lineSpacingExtra="3dp"
      android:text="@string/notifications_olhe_para_tras_e_veja_o_quanto"
      android:textColor="@color/iffit_muted"
      android:textSize="15sp" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/notifications_seus_marcos"
      android:textColor="@color/iffit_muted"
      android:textSize="12sp"
      android:letterSpacing="0.1" />
    <TextView
      android:id="@+id/conquistas"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:lineSpacingExtra="6dp"
      android:text="@string/notifications_carregando_conquistas"
      android:textColor="@color/iffit_text"
      android:textSize="22sp" />
    <View
      android:layout_width="match_parent"
      android:layout_height="1dp"
      android:layout_marginVertical="22dp"
      android:background="@color/iffit_border" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium"
      android:text="@string/notifications_fique_por_dentro"
      android:textColor="@color/iffit_text"
      android:textSize="24sp" />
    <TextView
      android:id="@+id/permissao"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="@color/iffit_muted"
      android:textSize="15sp" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/permitir"
      style="@style/Widget.MaterialComponents.Button.OutlinedButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:minHeight="54dp"
      android:text="@string/notifications_configurar_notificacoes"
      android:textAllCaps="false"
      android:textSize="15sp"
      app:cornerRadius="16dp"
      app:strokeColor="@color/iffit_border" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="20dp"
      android:lineSpacingExtra="3dp"
      android:text="@string/notifications_os_marcos_vem_do_seu_historico_lembretes"
      android:textColor="@color/iffit_muted"
      android:textSize="12sp" />
  </LinearLayout>
</ScrollView>