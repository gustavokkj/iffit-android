<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style
    name="Theme.IFFIT"
    parent="Theme.MaterialComponents.Light.NoActionBar">
    <item
      name="colorPrimary">@color/iffit_primary</item>
    <item
      name="colorPrimaryVariant">@color/iffit_dark</item>
    <item
      name="colorOnPrimary">@color/white</item>
    <item
      name="colorSecondary">@color/iffit_primary</item>
    <item
      name="colorSurface">@color/iffit_surface</item>
    <item
      name="colorOnSurface">@color/iffit_text</item>
    <item
      name="android:colorBackground">@color/iffit_background</item>
    <item
      name="android:windowBackground">@color/iffit_background</item>
    <item
      name="android:statusBarColor">@color/iffit_background</item>
    <item
      name="android:navigationBarColor">@color/iffit_surface</item>
    <item
      name="android:windowLightStatusBar">true</item>
    <item
      name="android:fontFamily">sans-serif</item>
    <item
      name="android:textColorPrimary">@color/iffit_text</item>
    <item
      name="android:textColorSecondary">@color/iffit_muted</item>
  </style>
  <style
    name="Theme.IFFIT.Starting"
    parent="Theme.SplashScreen">
    <item
      name="windowSplashScreenBackground">@color/iffit_surface</item>
    <item
      name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    <item
      name="postSplashScreenTheme">@style/Theme.IFFIT</item>
  </style>
</resources>